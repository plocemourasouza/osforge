{
  "$schema": "osforge/trigger-eval/v2",
  "skill": "code-review",
  "rel": "quality/code-review",
  "core": true,
  "note": "Revisão estruturada de mudanças de código.",
  "split": {
    "tune": [
      "p1",
      "p2",
      "p3",
      "n1",
      "n2",
      "n3",
      "n7"
    ],
    "eval": [
      "p4",
      "p5",
      "n4",
      "n5",
      "n6"
    ],
    "policy": "60/40 — ajuste a description olhando só 'tune'; 'eval' mede."
  },
  "cases": [
    {
      "id": "p1",
      "should_trigger": true,
      "category": "positivo",
      "expect_route": "code-review",
      "query": "Terminei a feature de cupom. Dá uma olhada antes de eu abrir o PR?"
    },
    {
      "id": "p2",
      "should_trigger": true,
      "category": "positivo",
      "expect_route": "code-review",
      "query": "Revisa esse diff com olhar crítico, principalmente a parte de permissão."
    },
    {
      "id": "p3",
      "should_trigger": true,
      "category": "positivo",
      "expect_route": "code-review",
      "query": "Quero uma segunda opinião nessas mudanças antes do merge."
    },
    {
      "id": "p4",
      "should_trigger": true,
      "category": "positivo",
      "expect_route": "code-review",
      "query": "O PR do estagiário está aberto há dois dias. Consegue revisar?"
    },
    {
      "id": "p5",
      "should_trigger": true,
      "category": "positivo",
      "expect_route": "code-review",
      "query": "Olha esse commit e me diz o que você mudaria."
    },
    {
      "id": "n1",
      "should_trigger": false,
      "category": "irrelevante",
      "expect_route": "tdd-workflow",
      "query": "Escreve a feature de cupom para mim."
    },
    {
      "id": "n2",
      "should_trigger": false,
      "category": "vizinho",
      "expect_route": "finishing-a-development-branch",
      "query": "Faz o merge da branch na main."
    },
    {
      "id": "n3",
      "should_trigger": false,
      "category": "irrelevante",
      "query": "Qual a convenção de commit que a gente usa mesmo?"
    },
    {
      "id": "n4",
      "should_trigger": false,
      "category": "irrelevante",
      "query": "Gera o changelog da versão 2.1."
    },
    {
      "id": "n5",
      "should_trigger": false,
      "category": "irrelevante",
      "query": "Roda o prettier em tudo."
    },
    {
      "id": "n6",
      "should_trigger": false,
      "category": "negacao",
      "critical": true,
      "query": "Não precisa revisar, só faz o commit do que está staged."
    },
    {
      "id": "n7",
      "should_trigger": false,
      "category": "vizinho",
      "expect_route": "receiving-code-review",
      "query": "O revisor pediu mudanças no meu PR; como eu respondo aos comentários?"
    }
  ]
}
